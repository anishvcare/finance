# === DEPLOY BRANCH ===
# This branch intentionally INCLUDES vendor/ and public/build/ so it can be
# downloaded as a ZIP and uploaded directly to cPanel (no composer/npm needed).
# The source-only branches (main / feature/*) exclude these.

/node_modules
/public/hot
/public/storage
/storage/*.key
/storage/app/private
/storage/app/public/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
.env
.env.backup
.env.production
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode
.DS_Store
/storage/installed.lock
