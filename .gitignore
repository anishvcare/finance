# === DEPLOY BRANCH ===
# This branch intentionally INCLUDES vendor/ and public/build/ so it can be
# downloaded as a ZIP and uploaded directly to cPanel (no composer/npm needed).
# The source-only branches (main / feature/*) exclude these.

/node_modules
/public/hot
/public/storage
/storage/*.key

# Keep storage folder structure but ignore runtime contents
/storage/app/public/*
!/storage/app/public/.gitkeep
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep

.env
.env.backup
.env.production
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode
.DS_Store
/storage/installed.lock
